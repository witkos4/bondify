---
import type { EmojiCheckInOption } from "@/lib/emoji-check-in";

interface Props {
  action: string;
  initialSelected?: string[];
  options: EmojiCheckInOption[];
  sessionId: string;
  teamId: string;
}

const props = Astro.props satisfies Props;
const { action, initialSelected = [], options, sessionId, teamId } = props;
const initialSelection = initialSelected.slice(0, 3);
const formId = `emoji-check-in-picker-${sessionId}`;
---

<form id={formId} method="POST" action={action} class="space-y-5" data-emoji-check-in-picker data-max-selections="3">
  <input type="hidden" name="teamId" value={teamId} />
  <input type="hidden" name="sessionId" value={sessionId} />

  <div class="flex items-center justify-between gap-3 rounded-3xl border border-white/10 bg-slate-950/25 px-4 py-3">
    <div>
      <p class="text-xs font-semibold tracking-[0.18em] text-cyan-100/60 uppercase">Your picks</p>
      <p class="mt-2 text-sm text-blue-100/70">Choose one to three emojis that match the team&apos;s day.</p>
    </div>
    <div
      class="rounded-full border border-white/10 bg-white/5 px-3 py-2 text-sm font-semibold text-white"
      data-selected-count
    >
      {initialSelection.length}/3
    </div>
  </div>

  <div class="grid gap-3 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
    {
      options.map((option, index) => {
        const optionId = `${formId}-${index}`;
        const isSelected = initialSelection.includes(option.emoji);

        return (
          <label class="block cursor-pointer" for={optionId}>
            <span class="sr-only">Select {option.label}</span>
            <input
              id={optionId}
              class="peer sr-only"
              type="checkbox"
              name="emojis"
              value={option.emoji}
              checked={isSelected}
              data-emoji-checkbox
              aria-label={option.label}
            />
            <span
              class="block rounded-3xl border border-white/10 bg-white/6 p-4 text-left transition peer-checked:border-amber-200/45 peer-checked:bg-amber-200/12 peer-checked:shadow-lg peer-checked:shadow-amber-500/10 hover:border-cyan-200/35 hover:bg-cyan-200/8"
              data-option-surface
            >
              <span class="flex items-start justify-between gap-4">
                <span class="min-w-0">
                  <span class="emoji-glyph text-3xl leading-none">{option.emoji}</span>
                  <span class="mt-3 block text-base font-semibold text-white">{option.label}</span>
                </span>
                <span
                  class="mt-1 inline-flex size-6 shrink-0 items-center justify-center rounded-full border border-white/10 bg-slate-950/35 text-xs font-semibold text-blue-100/45 transition peer-checked:border-amber-200/45 peer-checked:bg-amber-100/15 peer-checked:text-amber-100"
                  data-option-indicator
                >
                  <span data-indicator-off>+</span>
                  <span class="hidden" data-indicator-on aria-hidden="true">
                    &check;
                  </span>
                </span>
              </span>
            </span>
          </label>
        );
      })
    }
  </div>

  <div
    class="flex flex-col gap-4 rounded-3xl border border-white/10 bg-white/6 p-4 sm:flex-row sm:items-center sm:justify-between"
  >
    <div>
      <p class="text-sm font-semibold text-white" data-selected-message>
        {
          initialSelection.length === 0
            ? "Pick at least one emoji to join today's mood check."
            : `Ready to submit ${initialSelection.length} emoji${initialSelection.length === 1 ? "" : "s"}.`
        }
      </p>
      <p class="mt-1 text-xs leading-5 text-blue-100/55">
        After you submit, today&apos;s check-in is locked for your account.
      </p>
    </div>
    <button
      type="submit"
      class="rounded-2xl bg-cyan-400/90 px-5 py-3 text-sm font-semibold text-slate-950 transition hover:bg-cyan-300 disabled:cursor-not-allowed disabled:bg-slate-600 disabled:text-slate-300"
      data-submit-button
    >
      Save today&apos;s emojis
    </button>
  </div>
</form>

<script is:inline>
  (() => {
    const LOCKED_CLASS = "opacity-55";

    const syncPicker = (form) => {
      const maxSelections = Number(form.dataset.maxSelections ?? "3");
      const checkboxes = Array.from(form.querySelectorAll("input[data-emoji-checkbox]"));
      const selected = checkboxes.filter((checkbox) => checkbox.checked);
      const count = selected.length;
      const locked = count >= maxSelections;
      const countLabel = form.querySelector("[data-selected-count]");
      const messageLabel = form.querySelector("[data-selected-message]");
      const submitButton = form.querySelector("[data-submit-button]");

      if (countLabel) {
        countLabel.textContent = `${count}/${maxSelections}`;
      }

      if (messageLabel) {
        messageLabel.textContent =
          count === 0
            ? "Pick at least one emoji to join today's mood check."
            : `Ready to submit ${count} emoji${count === 1 ? "" : "s"}.`;
      }

      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = count === 0;
      }

      for (const checkbox of checkboxes) {
        const optionSurface = checkbox.parentElement?.querySelector("[data-option-surface]");
        const indicatorOn = checkbox.parentElement?.querySelector("[data-indicator-on]");
        const indicatorOff = checkbox.parentElement?.querySelector("[data-indicator-off]");
        const shouldDim = locked && !checkbox.checked;

        optionSurface?.classList.toggle(LOCKED_CLASS, shouldDim);
        if (indicatorOn && indicatorOff) {
          indicatorOn.classList.toggle("hidden", !checkbox.checked);
          indicatorOff.classList.toggle("hidden", checkbox.checked);
        }
      }
    };

    const attachPicker = (form) => {
      if (form.dataset.emojiPickerBound === "true") {
        syncPicker(form);
        return;
      }

      form.dataset.emojiPickerBound = "true";
      form.addEventListener("change", (event) => {
        const target = event.target;
        if (!(target instanceof HTMLInputElement) || target.type !== "checkbox") {
          return;
        }

        const maxSelections = Number(form.dataset.maxSelections ?? "3");
        const selectedCount = Array.from(form.querySelectorAll("input[data-emoji-checkbox]")).filter(
          (checkbox) => checkbox.checked,
        ).length;

        if (selectedCount > maxSelections) {
          target.checked = false;
        }

        syncPicker(form);
      });

      syncPicker(form);
    };

    for (const form of document.querySelectorAll("[data-emoji-check-in-picker]")) {
      attachPicker(form);
    }
  })();
</script>
