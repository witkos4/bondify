---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import EmojiCheckInPicker from "@/components/emoji-check-in/EmojiCheckInPicker.tsx";
import EmojiCheckInReveal from "@/components/emoji-check-in/EmojiCheckInReveal.tsx";
import { EMOJI_CHECK_IN_OPTIONS, EMOJI_CHECK_IN_TEMPLATE_SLUG } from "@/lib/emoji-check-in";
import { consumeDashboardFlash } from "@/lib/dashboard-flash";
import { callBondifyService, createBondifyServices } from "@/lib/services/bondify";
import type {
  BondifyGameTemplate,
  EmojiCheckInTimelineEntry,
  EmojiCheckInTodayState,
  TeamSummary,
  TeamInviteView,
} from "@/types";

const { user } = Astro.locals;
const services = createBondifyServices({
  requestHeaders: Astro.request.headers,
  cookies: Astro.cookies,
});

const selectedTeamId = Astro.url.searchParams.get("team");

const [shellContextResult, teamSummariesResult, incomingInvitesResult, gameTemplatesResult] = await Promise.all([
  callBondifyService(() => services.getShellContext({ preferredTeamId: selectedTeamId })),
  callBondifyService(() => services.getCurrentTeamSummaries()),
  callBondifyService(() => services.listPendingInvitesForCurrentProfile()),
  callBondifyService(() => services.listGameTemplates()),
]);

const shell = shellContextResult.data;
const teamSummaries: TeamSummary[] = teamSummariesResult.data ?? [];
const incomingInvites: TeamInviteView[] = incomingInvitesResult.data ?? [];
const gameTemplates: BondifyGameTemplate[] = gameTemplatesResult.data ?? [];
const dashboardFlash = consumeDashboardFlash(Astro.cookies);
const shellActiveTeamId = shell?.activeTeam?.id ?? null;
let selectedTeam: TeamSummary | null = null;

if (teamSummaries.length > 0) {
  selectedTeam = teamSummaries.find((summary) => summary.team.id === shellActiveTeamId) ?? teamSummaries[0];
}

let emojiCheckInState: EmojiCheckInTodayState | null = null;
let emojiCheckInTimeline: EmojiCheckInTimelineEntry[] = [];
let emojiCheckInErrorMessage: string | null = null;

if (selectedTeam) {
  const [emojiCheckInStateResult, emojiCheckInTimelineResult] = await Promise.all([
    callBondifyService(() =>
      services.getTodayEmojiCheckInState({
        teamId: selectedTeam.team.id,
      }),
    ),
    callBondifyService(() =>
      services.getEmojiCheckInTimeline({
        teamId: selectedTeam.team.id,
        days: 3,
      }),
    ),
  ]);

  emojiCheckInState = emojiCheckInStateResult.data;
  emojiCheckInTimeline = emojiCheckInTimelineResult.data ?? [];
  emojiCheckInErrorMessage =
    emojiCheckInStateResult.error?.message ?? emojiCheckInTimelineResult.error?.message ?? null;
}

const hasMemberships = selectedTeam !== null;
const activeTeamId = selectedTeam ? selectedTeam.team.id : "";
const activeTeamName = selectedTeam ? selectedTeam.team.name : "No active team selected";
const activeTeamMemberCount = selectedTeam ? selectedTeam.memberships.length : 0;
const activeTeamPendingInviteCount = selectedTeam ? selectedTeam.pendingInvites.length : 0;
const inviteAcceptedFlash = dashboardFlash?.type === "invite-accepted" ? dashboardFlash : null;
const inviteAcceptErrorFlash = dashboardFlash?.type === "invite-accept-error" ? dashboardFlash : null;
const shouldShowIncomingInvitesPanel =
  !hasMemberships && (incomingInvites.length > 0 || inviteAcceptedFlash !== null || inviteAcceptErrorFlash !== null);
const teamCreatedFlash = dashboardFlash?.type === "team-created" ? dashboardFlash : null;
const teamCreateErrorFlash = dashboardFlash?.type === "team-create-error" ? dashboardFlash : null;
const createTeamInputValue = teamCreateErrorFlash?.teamName ?? "";
const teamDeletedFlash = dashboardFlash?.type === "team-deleted" ? dashboardFlash : null;
const gameTemplatesErrorMessage = gameTemplatesResult.error?.message ?? null;
const emojiCheckInTemplate = gameTemplates.find((template) => template.slug === EMOJI_CHECK_IN_TEMPLATE_SLUG) ?? null;
const linkedGameTemplates = gameTemplates.filter((template) => template.slug !== EMOJI_CHECK_IN_TEMPLATE_SLUG);
const emojiCheckInSubmittedFlash =
  dashboardFlash?.type === "emoji-check-in-submitted" && dashboardFlash.teamId === activeTeamId ? dashboardFlash : null;
const emojiCheckInSubmitErrorFlash =
  dashboardFlash?.type === "emoji-check-in-submit-error" && dashboardFlash.teamId === activeTeamId
    ? dashboardFlash
    : null;
const emojiCheckInRevealedFlash =
  dashboardFlash?.type === "emoji-check-in-revealed" && dashboardFlash.teamId === activeTeamId ? dashboardFlash : null;
const emojiCheckInRevealErrorFlash =
  dashboardFlash?.type === "emoji-check-in-reveal-error" && dashboardFlash.teamId === activeTeamId
    ? dashboardFlash
    : null;
const emojiCheckInFlash =
  emojiCheckInSubmitErrorFlash ??
  emojiCheckInRevealErrorFlash ??
  emojiCheckInRevealedFlash ??
  emojiCheckInSubmittedFlash;
const emojiCheckInPickerInitialEmojis = emojiCheckInSubmitErrorFlash?.emojis ?? [];
const shouldTriggerEmojiCheckInBurst =
  emojiCheckInRevealedFlash?.sessionId !== undefined &&
  emojiCheckInRevealedFlash.sessionId === emojiCheckInState?.session.id;
const gamesOverviewErrorMessage = emojiCheckInErrorMessage ?? gameTemplatesErrorMessage;
const managementHref = hasMemberships ? `/teams/${encodeURIComponent(activeTeamId)}/manage` : null;

function formatInviteLabel(invite: TeamInviteView) {
  return `Sent to ${invite.invite.email}. Accept it to add that team to your authenticated shell.`;
}

function gameHref(teamId: string, gameSlug: string) {
  return `/teams/${encodeURIComponent(teamId)}/games/${encodeURIComponent(gameSlug)}`;
}

function historyHref(teamId: string) {
  return `/teams/${encodeURIComponent(teamId)}/history`;
}

function formatEmojiCheckInDate(value: string, options?: Intl.DateTimeFormatOptions) {
  return new Intl.DateTimeFormat("en", {
    month: "short",
    day: "numeric",
    ...options,
  }).format(new Date(`${value}T00:00:00Z`));
}
---

<Layout title="Dashboard">
  <div class="bg-cosmic min-h-screen">
    <div class="mx-auto max-w-6xl px-4 py-4 sm:px-8">
      <Topbar shell={shell} />

      <main class="mt-8 space-y-6 pb-12">
        <section>
          <div
            class="rounded-[2rem] border border-white/12 bg-white/6 p-6 text-white shadow-2xl shadow-black/20 backdrop-blur-xl sm:p-8"
          >
            <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
              <div class="max-w-2xl">
                <p class="text-xs font-semibold tracking-[0.3em] text-cyan-200/70 uppercase">Member overview</p>
                <h1
                  class="mt-3 bg-gradient-to-r from-cyan-100 via-sky-100 to-amber-100 bg-clip-text text-4xl font-semibold text-transparent sm:text-5xl"
                >
                  {
                    hasMemberships
                      ? `Start today's check-in with ${activeTeamName}`
                      : `Welcome back${user?.email ? `, ${user.email}` : ""}.`
                  }
                </h1>
                <p class="mt-4 max-w-2xl text-base leading-7 text-blue-100/75">
                  {
                    hasMemberships
                      ? "Your selected team now lands on a member-first dashboard. Begin with the daily Emoji Check-In, branch into linked games when you want a deeper prompt, and head to team management separately when you need setup work."
                      : "You’re signed in and inside the authenticated shell. Create your first team here, and Bondify will promote it into the games overview without sending you back through the public landing page."
                  }
                </p>
              </div>

              <div class="min-w-[18rem] rounded-3xl border border-white/10 bg-slate-950/30 p-4">
                <p class="text-xs font-semibold tracking-[0.25em] text-cyan-200/65 uppercase">
                  {hasMemberships ? "Selected team" : "Create-first state"}
                </p>
                <h2 class="mt-2 text-2xl font-semibold text-white">{activeTeamName}</h2>
                {
                  hasMemberships ? (
                    <p class="mt-2 text-sm text-blue-100/60">
                      {activeTeamMemberCount} members
                      {" · "}
                      {activeTeamPendingInviteCount} pending invites
                    </p>
                  ) : (
                    <p class="mt-2 text-sm leading-6 text-blue-100/65">
                      No team memberships yet. The first team you create becomes your active context immediately.
                    </p>
                  )
                }
                <a
                  href={hasMemberships ? "#emoji-check-in" : "#create-team-next"}
                  class="mt-4 inline-flex rounded-2xl border border-white/10 px-4 py-3 text-sm font-semibold text-blue-100 transition hover:bg-white/10"
                >
                  {hasMemberships ? "Jump to today's ritual" : "Create your first team"}
                </a>
              </div>
            </div>
          </div>
        </section>

        {
          (teamCreatedFlash !== null ||
            teamDeletedFlash !== null ||
            (hasMemberships && inviteAcceptedFlash !== null)) && (
            <section class="space-y-3">
              {teamCreatedFlash && (
                <div class="rounded-[2rem] border border-emerald-300/25 bg-emerald-300/10 p-4 text-sm leading-6 text-emerald-100 shadow-xl shadow-black/20 backdrop-blur-xl">
                  {teamCreatedFlash.message}
                </div>
              )}

              {teamDeletedFlash && (
                <div class="rounded-[2rem] border border-emerald-300/25 bg-emerald-300/10 p-4 text-sm leading-6 text-emerald-100 shadow-xl shadow-black/20 backdrop-blur-xl">
                  {teamDeletedFlash.message}
                </div>
              )}

              {hasMemberships && inviteAcceptedFlash && (
                <div class="rounded-[2rem] border border-emerald-300/25 bg-emerald-300/10 p-4 text-sm leading-6 text-emerald-100 shadow-xl shadow-black/20 backdrop-blur-xl">
                  {inviteAcceptedFlash.message}
                </div>
              )}
            </section>
          )
        }

        {
          shouldShowIncomingInvitesPanel && (
            <section
              id="incoming-invites"
              class="rounded-[2rem] border border-white/12 bg-slate-950/35 p-6 text-white shadow-xl shadow-black/20 backdrop-blur-xl sm:p-8"
            >
              <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                <div class="max-w-2xl">
                  <p class="text-xs font-semibold tracking-[0.25em] text-cyan-200/65 uppercase">Incoming invites</p>
                  <h2 class="mt-3 text-2xl font-semibold text-white">Teams waiting for you</h2>
                  <p class="mt-2 text-sm leading-6 text-blue-100/65">
                    Accept invitations addressed to your account email here. Joined teams become selectable immediately
                    from the authenticated shell.
                  </p>
                </div>

                {incomingInvites.length > 0 && (
                  <div class="rounded-3xl border border-white/10 bg-white/6 px-4 py-3 text-sm text-blue-100/65">
                    {incomingInvites.length} pending invite{incomingInvites.length === 1 ? "" : "s"}
                  </div>
                )}
              </div>

              {inviteAcceptedFlash && (
                <div class="mt-5 rounded-3xl border border-emerald-300/25 bg-emerald-300/10 p-4 text-sm leading-6 text-emerald-100">
                  {inviteAcceptedFlash.message}
                </div>
              )}

              {inviteAcceptErrorFlash && (
                <div class="mt-5 rounded-3xl border border-red-500/30 bg-red-900/40 p-4 text-sm leading-6 text-red-300">
                  {inviteAcceptErrorFlash.message}
                </div>
              )}

              {incomingInvites.length > 0 && (
                <ul class="mt-6 grid gap-3 md:grid-cols-2">
                  {incomingInvites.map((invite) => (
                    <li class="rounded-3xl border border-white/10 bg-white/6 p-4">
                      <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                        <div>
                          <p class="text-sm font-medium text-white">{invite.invite.email}</p>
                          <p class="mt-1 text-sm text-blue-100/65">Status: {invite.invite.status}</p>
                          <p class="mt-2 text-xs leading-5 text-blue-100/50">{formatInviteLabel(invite)}</p>
                        </div>
                        <form method="POST" action="/api/teams/accept-invite" class="sm:min-w-36">
                          <input type="hidden" name="inviteId" value={invite.invite.id} />
                          <input type="hidden" name="surface" value="dashboard" />
                          <button
                            type="submit"
                            class="w-full rounded-2xl bg-emerald-300/90 px-4 py-2 text-sm font-semibold text-slate-950 transition hover:bg-emerald-200"
                          >
                            Accept invite
                          </button>
                        </form>
                      </div>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          )
        }

        {
          hasMemberships ? (
            <>
              <section
                id="games-overview"
                class="rounded-[2rem] border border-white/12 bg-slate-950/35 p-6 text-white shadow-xl shadow-black/20 backdrop-blur-xl sm:p-8"
              >
                <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
                  <div class="max-w-2xl">
                    <p class="text-xs font-semibold tracking-[0.25em] text-cyan-200/65 uppercase">Games overview</p>
                    <h2 class="mt-2 text-3xl font-semibold">
                      Start with today's ritual, then branch into the other games
                    </h2>
                    <p class="mt-3 text-sm leading-6 text-blue-100/65">
                      Emoji Check-In now lives here on the selected-team dashboard. The rest of the game catalog stays
                      linked and equally reachable for deeper prompts whenever your team wants something beyond today's
                      mood signal.
                    </p>
                  </div>
                  <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
                    <a
                      href={historyHref(activeTeamId)}
                      class="inline-flex justify-center rounded-2xl border border-white/15 px-4 py-3 text-sm font-semibold text-blue-100 transition hover:bg-white/10"
                    >
                      View full team history
                    </a>
                    <div class="rounded-3xl border border-white/10 bg-white/6 px-4 py-3 text-sm text-blue-100/65">
                      {linkedGameTemplates.length} linked game{linkedGameTemplates.length === 1 ? "" : "s"}
                    </div>
                  </div>
                </div>

                {gamesOverviewErrorMessage && (
                  <div class="mt-5 rounded-3xl border border-red-500/30 bg-red-900/40 p-4 text-sm leading-6 text-red-300">
                    {gamesOverviewErrorMessage}
                  </div>
                )}

                <section
                  id="emoji-check-in"
                  class="mt-6 rounded-[2rem] border border-amber-200/15 bg-[radial-gradient(circle_at_top_left,_rgba(251,191,36,0.16),_transparent_38%),linear-gradient(135deg,rgba(15,23,42,0.94),rgba(8,47,73,0.9))] p-6 shadow-xl shadow-black/25"
                >
                  <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                    <div class="max-w-2xl">
                      <p class="text-xs font-semibold tracking-[0.22em] text-amber-100/70 uppercase">Today's ritual</p>
                      <h3 class="mt-2 text-3xl font-semibold text-white">
                        {emojiCheckInTemplate?.name ?? "Emoji Check-In"}
                      </h3>
                      <p class="mt-3 text-sm leading-6 text-blue-100/75">
                        {emojiCheckInTemplate?.prompt ??
                          "Pick one to three emojis that capture how today feels for your team."}
                      </p>
                    </div>

                    {emojiCheckInState && (
                      <div class="rounded-3xl border border-white/10 bg-slate-950/30 px-4 py-3 text-right">
                        <p class="text-xs tracking-[0.2em] text-blue-100/45 uppercase">Team day</p>
                        <p class="mt-1 text-lg font-semibold text-white">
                          {formatEmojiCheckInDate(emojiCheckInState.session.sessionDate, {
                            weekday: "short",
                            month: "short",
                            day: "numeric",
                          })}
                        </p>
                        {!emojiCheckInState.revealedSummary && (
                          <p class="mt-2 text-xs text-blue-100/60">
                            {emojiCheckInState.submittedCount} teammate
                            {emojiCheckInState.submittedCount === 1 ? "" : "s"} checked in
                          </p>
                        )}
                      </div>
                    )}
                  </div>

                  {emojiCheckInFlash && (
                    <div
                      class:list={[
                        "mt-5 rounded-3xl border p-4 text-sm leading-6",
                        emojiCheckInFlash.type === "emoji-check-in-submit-error" ||
                        emojiCheckInFlash.type === "emoji-check-in-reveal-error"
                          ? "border-red-500/30 bg-red-900/40 text-red-200"
                          : "border-emerald-300/25 bg-emerald-300/10 text-emerald-100",
                      ]}
                    >
                      {emojiCheckInFlash.message}
                    </div>
                  )}

                  {emojiCheckInState ? (
                    <div class="mt-6 space-y-6">
                      {emojiCheckInState.revealedSummary ? (
                        <EmojiCheckInReveal
                          client:load
                          emojiCounts={emojiCheckInState.revealedSummary.emojiCounts}
                          submittedCount={emojiCheckInState.revealedSummary.submittedCount}
                          triggerBurst={shouldTriggerEmojiCheckInBurst}
                        />
                      ) : emojiCheckInState.hasCurrentMemberSubmitted ? (
                        <div class="grid gap-6 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
                          <div>
                            <p class="text-xs font-semibold tracking-[0.2em] text-emerald-100/75 uppercase">
                              Checked in
                            </p>
                            <h4 class="mt-2 text-3xl font-semibold text-white">Your signal is in for today</h4>
                            <p class="mt-3 max-w-2xl text-sm leading-6 text-blue-100/70">
                              The dashboard keeps names out of sight until reveal time. What everyone can see right now
                              is anonymous momentum only.
                            </p>
                            {emojiCheckInState.currentMemberSubmission && (
                              <div class="mt-5 flex flex-wrap gap-3">
                                {emojiCheckInState.currentMemberSubmission.emojis.map((emoji) => (
                                  <span class="inline-flex items-center rounded-full border border-amber-200/35 bg-amber-200/12 px-4 py-2 text-2xl">
                                    {emoji}
                                  </span>
                                ))}
                              </div>
                            )}
                          </div>

                          <div class="rounded-[2rem] border border-white/10 bg-white/6 p-5">
                            <p class="text-xs font-semibold tracking-[0.18em] text-blue-100/50 uppercase">
                              Ready to reveal
                            </p>
                            <p class="mt-2 text-sm leading-6 text-blue-100/60">
                              {emojiCheckInState.submittedCount} teammate
                              {emojiCheckInState.submittedCount === 1 ? "" : "s"} checked in so far. Names stay hidden
                              until reveal.
                            </p>
                            <form method="POST" action="/api/games/emoji-check-in/reveal" class="mt-5">
                              <input type="hidden" name="teamId" value={activeTeamId} />
                              <input type="hidden" name="sessionId" value={emojiCheckInState.session.id} />
                              <button
                                type="submit"
                                class="w-full rounded-2xl bg-emerald-300/90 px-4 py-3 text-sm font-semibold text-slate-950 transition hover:bg-emerald-200"
                              >
                                Reveal team mood
                              </button>
                            </form>
                          </div>
                        </div>
                      ) : (
                        <div>
                          <div>
                            <p class="text-xs font-semibold tracking-[0.2em] text-cyan-100/65 uppercase">
                              Submit your mood
                            </p>
                            <h4 class="mt-2 text-3xl font-semibold text-white">Pick the emojis that fit today</h4>
                            <p class="mt-3 max-w-2xl text-sm leading-6 text-blue-100/70">
                              One check-in per teammate, one shared reveal for the whole group.
                            </p>

                            <div class="mt-6">
                              <EmojiCheckInPicker
                                client:load
                                teamId={activeTeamId}
                                sessionId={emojiCheckInState.session.id}
                                action="/api/games/emoji-check-in/submit"
                                options={EMOJI_CHECK_IN_OPTIONS}
                                initialSelected={emojiCheckInPickerInitialEmojis}
                              />
                            </div>
                          </div>
                        </div>
                      )}

                      <div class="rounded-[2rem] border border-white/10 bg-slate-950/25 p-5">
                        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
                          <div>
                            <p class="text-xs font-semibold tracking-[0.2em] text-cyan-100/65 uppercase">
                              Emoji Check-In preview
                            </p>
                            <h4 class="mt-2 text-2xl font-semibold text-white">Last 3 revealed days</h4>
                            <p class="mt-3 text-sm leading-6 text-blue-100/65">
                              The dashboard keeps just the newest reveals. Open team history for the full 30-day line.
                            </p>
                          </div>
                          <div class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-blue-100/60">
                            {emojiCheckInTimeline.length} revealed day{emojiCheckInTimeline.length === 1 ? "" : "s"}
                          </div>
                        </div>

                        {emojiCheckInTimeline.length > 0 ? (
                          <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                            {emojiCheckInTimeline.map((entry) => (
                              <article
                                class:list={[
                                  "rounded-3xl border bg-white/6 p-4",
                                  entry.session.id === emojiCheckInState.session.id
                                    ? "border-amber-200/25 shadow-lg shadow-amber-500/10"
                                    : "border-white/10",
                                ]}
                              >
                                <div class="flex items-start justify-between gap-4">
                                  <div>
                                    <p class="text-xs font-semibold tracking-[0.18em] text-cyan-100/60 uppercase">
                                      {formatEmojiCheckInDate(entry.session.sessionDate, {
                                        weekday: "short",
                                        month: "short",
                                        day: "numeric",
                                      })}
                                    </p>
                                    <p class="mt-2 text-sm text-blue-100/60">
                                      {entry.submittedCount} teammate{entry.submittedCount === 1 ? "" : "s"} checked in
                                    </p>
                                  </div>
                                  {entry.session.id === emojiCheckInState.session.id && (
                                    <span class="rounded-full border border-amber-200/30 bg-amber-100/10 px-3 py-1 text-xs font-semibold tracking-[0.18em] text-amber-100 uppercase">
                                      Today
                                    </span>
                                  )}
                                </div>

                                <div class="mt-4 flex flex-wrap gap-2">
                                  {entry.emojiCounts.map((count) => (
                                    <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-slate-950/35 px-3 py-2 text-sm text-white">
                                      <span class="text-xl">{count.emoji}</span>
                                      <span class="text-blue-100/70">×{count.count}</span>
                                    </span>
                                  ))}
                                </div>
                              </article>
                            ))}
                          </div>
                        ) : (
                          <div class="mt-6 rounded-3xl border border-white/10 bg-white/6 p-4 text-sm leading-6 text-blue-100/65">
                            The timeline starts after the first revealed Emoji Check-In day.
                          </div>
                        )}
                      </div>
                    </div>
                  ) : (
                    <div class="mt-6 rounded-3xl border border-white/10 bg-white/6 p-4 text-sm leading-6 text-blue-100/65">
                      Today's Emoji Check-In is unavailable right now.
                    </div>
                  )}
                </section>

                <section class="mt-6 rounded-[2rem] border border-white/10 bg-white/6 p-6">
                  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
                    <div class="max-w-2xl">
                      <p class="text-xs font-semibold tracking-[0.2em] text-cyan-100/60 uppercase">Linked games</p>
                      <h3 class="mt-2 text-2xl font-semibold text-white">Other ways to play with the team</h3>
                      <p class="mt-3 text-sm leading-6 text-blue-100/65">
                        These games keep their current page-based flow. Open one when your team wants a deeper prompt
                        beyond the daily check-in.
                      </p>
                    </div>
                  </div>

                  {linkedGameTemplates.length > 0 ? (
                    <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                      {linkedGameTemplates.map((template) => (
                        <article class="flex min-h-56 flex-col rounded-3xl border border-white/10 bg-slate-950/25 p-5">
                          <p class="text-xs font-semibold tracking-[0.2em] text-cyan-100/60 uppercase">
                            {template.isHistoryEnabled ? "History-ready" : "Live only"}
                          </p>
                          <h4 class="mt-3 text-xl font-semibold text-white">{template.name}</h4>
                          <p class="mt-3 flex-1 text-sm leading-6 text-blue-100/65">{template.prompt}</p>
                          <a
                            href={gameHref(activeTeamId, template.slug)}
                            class="mt-5 inline-flex justify-center rounded-2xl bg-cyan-400/90 px-4 py-3 text-sm font-semibold text-slate-950 transition hover:bg-cyan-300"
                          >
                            Open linked game
                          </a>
                        </article>
                      ))}
                    </div>
                  ) : (
                    <div class="mt-6 rounded-3xl border border-white/10 bg-slate-950/25 p-4 text-sm leading-6 text-blue-100/65">
                      No linked games are available yet.
                    </div>
                  )}
                </section>
              </section>

              <section class="rounded-[2rem] border border-white/12 bg-white/6 p-6 text-white shadow-xl shadow-black/20 backdrop-blur-xl sm:p-8">
                <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
                  <div class="max-w-2xl">
                    <p class="text-xs font-semibold tracking-[0.25em] text-cyan-200/65 uppercase">Team management</p>
                    <h2 class="mt-2 text-3xl font-semibold">Setup work moved onto its own page</h2>
                    <p class="mt-3 text-sm leading-6 text-blue-100/65">
                      Roster review, incoming invites, batch teammate invites, and owner-only controls now live on a
                      dedicated management surface. The dashboard stays focused on daily play.
                    </p>
                  </div>

                  <div class="rounded-3xl border border-white/10 bg-slate-950/35 px-4 py-3 text-right">
                    <p class="text-xs tracking-[0.2em] text-blue-100/45 uppercase">Selected team</p>
                    <p class="mt-1 text-lg font-semibold text-white">{selectedTeam.team.name}</p>
                    <p class="mt-1 text-sm text-blue-100/60">
                      {activeTeamMemberCount} members
                      {" · "}
                      {activeTeamPendingInviteCount} pending invites
                    </p>
                  </div>
                </div>

                <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
                  <a
                    href={managementHref ?? "/dashboard"}
                    class="inline-flex justify-center rounded-2xl bg-cyan-400/90 px-4 py-3 text-sm font-semibold text-slate-950 transition hover:bg-cyan-300"
                  >
                    Open team management
                  </a>
                  <p class="text-sm leading-6 text-blue-100/60">
                    Use the separate page whenever you need to change roster state without leaving the authenticated
                    shell.
                  </p>
                </div>
              </section>
            </>
          ) : (
            <section
              id="create-team-next"
              class="grid gap-6 rounded-[2rem] border border-white/12 bg-white/6 p-6 text-white shadow-xl shadow-black/20 backdrop-blur-xl sm:p-8 lg:grid-cols-[1.3fr_1fr]"
            >
              <div>
                <p class="text-xs font-semibold tracking-[0.25em] text-cyan-200/65 uppercase">Create your team</p>
                <h2 class="mt-2 text-3xl font-semibold">Start your first Bondify team here</h2>
                <p class="mt-3 max-w-2xl text-sm leading-7 text-blue-100/70">
                  The public landing is behind you now. Create your first team from this authenticated dashboard and
                  Bondify will unlock the member-first shell immediately.
                </p>
                {teamCreateErrorFlash && (
                  <div class="mt-6 rounded-3xl border border-red-500/30 bg-red-900/40 p-4 text-sm leading-6 text-red-300">
                    {teamCreateErrorFlash.message}
                  </div>
                )}
                <form method="POST" action="/api/teams/create" class="mt-6 space-y-4">
                  <input type="hidden" name="surface" value="dashboard" />
                  <div>
                    <label class="block text-sm font-medium text-blue-100/75" for="empty-team-name">
                      Team name
                    </label>
                    <input
                      id="empty-team-name"
                      name="teamName"
                      type="text"
                      value={createTeamInputValue}
                      placeholder="Friday Ritual Crew"
                      class="mt-2 w-full rounded-2xl border border-white/10 bg-slate-950/35 px-4 py-3 text-white transition outline-none focus:border-cyan-300/70"
                    />
                  </div>
                  <button
                    type="submit"
                    class="inline-flex rounded-2xl bg-cyan-400/90 px-5 py-3 text-sm font-semibold text-slate-950 transition hover:bg-cyan-300"
                  >
                    Create team
                  </button>
                </form>
              </div>

              <div class="rounded-[2rem] border border-white/10 bg-slate-950/25 p-6">
                <p class="text-xs font-semibold tracking-[0.25em] text-cyan-200/65 uppercase">What’s already real</p>
                <h2 class="mt-2 text-2xl font-semibold">Authenticated shell is ready</h2>
                <ul class="mt-4 space-y-3 text-sm leading-6 text-blue-100/65">
                  <li>Your signed-in profile is already loaded from the Bondify service layer.</li>
                  <li>Creating the first team promotes you straight into the selected-team dashboard.</li>
                  <li>Matching invites still surface in this authenticated area when no active team exists yet.</li>
                </ul>
              </div>
            </section>
          )
        }
      </main>
    </div>
  </div>
</Layout>
