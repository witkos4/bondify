---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { getEmojiCheckInOption } from "@/lib/emoji-check-in";
import { consumeHistoryFlash } from "@/lib/history-flash";
import { callBondifyService, createBondifyServices } from "@/lib/services/bondify";
import type { ParticipantSafeHistoryEntry, TeamHistoryState } from "@/types";

export const prerender = false;

interface HistoryGroup {
  key: string;
  template: ParticipantSafeHistoryEntry["template"];
  entries: ParticipantSafeHistoryEntry[];
}

const { teamId = "" } = Astro.params;
const decodedTeamId = decodeURIComponent(teamId);
const services = createBondifyServices({
  requestHeaders: Astro.request.headers,
  cookies: Astro.cookies,
});

const [shellContextResult, historyStateResult] = await Promise.all([
  callBondifyService(() => services.getShellContext({ preferredTeamId: decodedTeamId })),
  callBondifyService(() => services.getTeamHistoryState(decodedTeamId)),
]);

const shell = shellContextResult.data;
const historyState: TeamHistoryState | null = historyStateResult.data;
const historyFlash = consumeHistoryFlash(Astro.cookies);
const matchingFlash = historyFlash?.teamId === decodedTeamId ? historyFlash : null;
const errorMessage = historyStateResult.error?.message ?? null;
const pageTitle = historyState ? `${historyState.team.name} history | Bondify` : "Team history | Bondify";

function formatDateTime(value: string | null) {
  if (!value) {
    return "Not revealed";
  }

  return new Intl.DateTimeFormat("en", {
    month: "short",
    day: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  }).format(new Date(value));
}

function formatDate(value: string | null) {
  if (!value) {
    return "";
  }

  return new Intl.DateTimeFormat("en", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }).format(new Date(value));
}

function formatSessionDate(value: string) {
  return new Intl.DateTimeFormat("en", {
    weekday: "short",
    month: "short",
    day: "numeric",
  }).format(new Date(`${value}T00:00:00Z`));
}

function getEmojiCheckInLabel(emoji: string) {
  return getEmojiCheckInOption(emoji)?.label ?? "Shared signal";
}

function groupHistoryEntries(entries: ParticipantSafeHistoryEntry[]): HistoryGroup[] {
  const groups = new Map<string, HistoryGroup>();

  for (const entry of entries) {
    const key = entry.template.slug;
    const existingGroup = groups.get(key);

    if (existingGroup) {
      existingGroup.entries.push(entry);
      continue;
    }

    groups.set(key, {
      key,
      template: entry.template,
      entries: [entry],
    });
  }

  return Array.from(groups.values());
}

function statementLabel(index: number) {
  return `Statement ${index}`;
}

const historyGroups = historyState ? groupHistoryEntries(historyState.entries) : [];
const emojiTimeline = historyState?.emojiCheckInTimeline ?? [];
const hasEmojiHistory = emojiTimeline.length > 0;
const hasLinkedGameHistory = historyGroups.length > 0;
---

<Layout title={pageTitle}>
  <div class="bg-cosmic min-h-screen">
    <div class="mx-auto max-w-6xl px-4 py-4 sm:px-8">
      <Topbar shell={shell} />

      <main class="mt-8 space-y-6 pb-12">
        {
          historyState ? (
            <>
              <section class="rounded-[2rem] border border-white/12 bg-white/6 p-6 text-white shadow-2xl shadow-black/20 backdrop-blur-xl sm:p-8">
                <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
                  <div class="max-w-3xl">
                    <p class="text-xs font-semibold tracking-[0.28em] text-cyan-200/70 uppercase">Team history</p>
                    <h1 class="mt-3 text-4xl font-semibold text-white sm:text-5xl">{historyState.team.name}</h1>
                  </div>
                  <div class="flex flex-col gap-3 sm:flex-row">
                    <a
                      href={`/dashboard?team=${encodeURIComponent(historyState.team.id)}`}
                      class="inline-flex justify-center rounded-2xl border border-white/15 px-4 py-3 text-sm font-semibold text-blue-100 transition hover:bg-white/10"
                    >
                      Back to dashboard
                    </a>
                    {historyState.canClearHistory && hasLinkedGameHistory && (
                      <form method="POST" action="/api/teams/clear-history">
                        <input type="hidden" name="teamId" value={historyState.team.id} />
                        <button
                          type="submit"
                          class="w-full rounded-2xl border border-red-300/25 bg-red-400/15 px-4 py-3 text-sm font-semibold text-red-100 transition hover:bg-red-400/25 sm:w-auto"
                        >
                          Clear linked game history
                        </button>
                      </form>
                    )}
                  </div>
                </div>

                {matchingFlash && (
                  <div
                    class:list={[
                      "mt-6 rounded-3xl border p-4 text-sm leading-6",
                      matchingFlash.type === "history-cleared"
                        ? "border-emerald-300/25 bg-emerald-300/10 text-emerald-100"
                        : "border-red-500/30 bg-red-900/40 text-red-200",
                    ]}
                  >
                    {matchingFlash.message}
                  </div>
                )}
              </section>

              {hasEmojiHistory && (
                <section class="space-y-4 rounded-[2rem] border border-white/12 bg-slate-950/35 p-6 text-white shadow-xl shadow-black/20 backdrop-blur-xl sm:p-8">
                  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
                    <div>
                      <p class="text-xs font-semibold tracking-[0.25em] text-cyan-200/65 uppercase">
                        Emoji Check-In history
                      </p>
                      <h2 class="mt-2 text-3xl font-semibold">30-day mood line</h2>
                      <p class="mt-3 max-w-2xl text-sm leading-6 text-blue-100/65">
                        Revealed days only. This keeps the daily signal together in one place while the dashboard stays
                        focused on the latest three check-ins.
                      </p>
                    </div>
                    <div class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-blue-100/60">
                      {emojiTimeline.length} revealed day{emojiTimeline.length === 1 ? "" : "s"}
                    </div>
                  </div>

                  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                    {emojiTimeline.map((entry) => (
                      <article class="rounded-3xl border border-white/10 bg-white/6 p-4">
                        <div class="flex items-start justify-between gap-4">
                          <div>
                            <p class="text-xs font-semibold tracking-[0.18em] text-cyan-100/60 uppercase">
                              {formatSessionDate(entry.session.sessionDate)}
                            </p>
                            <p class="mt-2 text-sm text-blue-100/60">
                              {entry.submittedCount} teammate{entry.submittedCount === 1 ? "" : "s"} checked in
                            </p>
                          </div>
                        </div>

                        <div class="mt-4 flex flex-wrap gap-2">
                          {entry.emojiCounts.map((count) => (
                            <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-slate-950/35 px-3 py-2 text-sm text-white">
                              <span class="emoji-glyph text-xl leading-none">{count.emoji}</span>
                              <span>{getEmojiCheckInLabel(count.emoji)}</span>
                              <span class="text-blue-100/70">x{count.count}</span>
                            </span>
                          ))}
                        </div>
                      </article>
                    ))}
                  </div>
                </section>
              )}

              {hasLinkedGameHistory ? (
                historyGroups.map((group) => (
                  <section class="space-y-4 rounded-[2rem] border border-white/12 bg-slate-950/35 p-6 text-white shadow-xl shadow-black/20 backdrop-blur-xl sm:p-8">
                    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
                      <div>
                        <p class="text-xs font-semibold tracking-[0.25em] text-cyan-200/65 uppercase">
                          {group.entries.length} round{group.entries.length === 1 ? "" : "s"}
                        </p>
                        <h2 class="mt-2 text-3xl font-semibold">{group.template.name}</h2>
                        <p class="mt-3 max-w-2xl text-sm leading-6 text-blue-100/65">{group.template.prompt}</p>
                      </div>
                    </div>

                    <div class="grid gap-4">
                      {group.entries.map((entry) => (
                        <article class="rounded-3xl border border-white/10 bg-white/6 p-5">
                          <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                            <div>
                              <p class="text-xs font-semibold tracking-[0.2em] text-emerald-100/70 uppercase">
                                Revealed {formatDateTime(entry.round.revealedAt)}
                              </p>
                              <h3 class="mt-2 text-xl font-semibold text-white">
                                {entry.twoTruthsSummary
                                  ? `${entry.twoTruthsSummary.entries.length} structured set${entry.twoTruthsSummary.entries.length === 1 ? "" : "s"}`
                                  : `${entry.responses.length} anonymous response${entry.responses.length === 1 ? "" : "s"}`}
                              </h3>
                              {entry.round.historyVisibleUntil && (
                                <p class="mt-2 text-xs text-blue-100/45">
                                  Visible until {formatDate(entry.round.historyVisibleUntil)}
                                </p>
                              )}
                            </div>

                            {historyState.canClearHistory && (
                              <form method="POST" action="/api/teams/clear-history" class="lg:min-w-36">
                                <input type="hidden" name="teamId" value={historyState.team.id} />
                                <input type="hidden" name="roundId" value={entry.round.id} />
                                <button
                                  type="submit"
                                  class="w-full rounded-2xl border border-red-300/20 bg-red-400/10 px-4 py-2 text-sm font-semibold text-red-100 transition hover:bg-red-400/20"
                                >
                                  Clear
                                </button>
                              </form>
                            )}
                          </div>

                          {entry.twoTruthsSummary ? (
                            <div class="mt-5 space-y-5">
                              <section class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                                {entry.twoTruthsSummary.revealSummary.scores.map((score) => (
                                  <article class="rounded-3xl border border-white/10 bg-slate-950/25 p-4">
                                    <p class="text-xs font-semibold tracking-[0.18em] text-cyan-100/60 uppercase">
                                      {score.participant.email}
                                    </p>
                                    <p class="mt-2 text-3xl font-semibold text-white">{score.totalScore}</p>
                                    <p class="mt-3 text-sm leading-6 text-blue-100/65">
                                      {score.correctGuessCount} correct guess{score.correctGuessCount === 1 ? "" : "es"}{" "}
                                      and {score.fooledTeammateCount} teammate
                                      {score.fooledTeammateCount === 1 ? "" : "s"} fooled
                                    </p>
                                  </article>
                                ))}
                              </section>

                              <section class="grid gap-4">
                                {entry.twoTruthsSummary.entries.map((structuredEntry) => (
                                  <article class="rounded-3xl border border-white/10 bg-slate-950/25 p-4">
                                    <p class="text-xs font-semibold tracking-[0.18em] text-amber-100/70 uppercase">
                                      {structuredEntry.author.email}
                                    </p>
                                    <ol class="mt-4 grid gap-3 md:grid-cols-3">
                                      {structuredEntry.statements.map((statement, index) => {
                                        const isLie = structuredEntry.lieStatementIndex === index + 1;

                                        return (
                                          <li
                                            class:list={[
                                              "rounded-2xl border px-4 py-3 text-sm leading-6",
                                              isLie
                                                ? "border-amber-300/30 bg-amber-300/10 text-amber-50"
                                                : "border-white/10 bg-white/6 text-white",
                                            ]}
                                          >
                                            <span class="mb-1 block text-xs font-semibold tracking-[0.18em] uppercase">
                                              {statementLabel(index + 1)}
                                            </span>
                                            <p>{statement}</p>
                                            {isLie ? (
                                              <p class="mt-3 text-xs font-semibold tracking-[0.16em] text-amber-100 uppercase">
                                                Lie
                                              </p>
                                            ) : null}
                                          </li>
                                        );
                                      })}
                                    </ol>
                                  </article>
                                ))}
                              </section>
                            </div>
                          ) : (
                            <div class="mt-5 grid gap-3 md:grid-cols-2">
                              {entry.responses.map((response, index) => (
                                <div class="rounded-2xl border border-white/10 bg-slate-950/25 p-4">
                                  <div class="flex items-start justify-between gap-3">
                                    <p class="text-xs font-semibold tracking-[0.18em] text-cyan-100/60 uppercase">
                                      Response {index + 1}
                                    </p>
                                    <time class="text-xs text-blue-100/45" datetime={response.createdAt}>
                                      {formatDateTime(response.createdAt)}
                                    </time>
                                  </div>
                                  <p class="mt-3 text-sm leading-6 whitespace-pre-wrap text-white">
                                    {response.responseText}
                                  </p>
                                </div>
                              ))}
                            </div>
                          )}
                        </article>
                      ))}
                    </div>
                  </section>
                ))
              ) : (
                <section class="rounded-[2rem] border border-white/12 bg-slate-950/35 p-6 text-white shadow-xl shadow-black/20 backdrop-blur-xl sm:p-8">
                  <p class="text-xs font-semibold tracking-[0.25em] text-cyan-200/65 uppercase">No history yet</p>
                  <h2 class="mt-2 text-3xl font-semibold">Selected game results will appear here</h2>
                </section>
              )}
            </>
          ) : (
            <section class="rounded-[2rem] border border-red-500/25 bg-red-950/45 p-6 text-red-100 shadow-xl shadow-black/20 backdrop-blur-xl sm:p-8">
              <p class="text-xs font-semibold tracking-[0.25em] text-red-200/70 uppercase">History unavailable</p>
              <h1 class="mt-2 text-3xl font-semibold">This team history could not be loaded</h1>
              <p class="mt-3 text-sm leading-6 text-red-100/75">
                {errorMessage ?? "Check that you are signed in and belong to this team."}
              </p>
              <a
                href="/dashboard"
                class="mt-6 inline-flex rounded-2xl border border-red-100/25 px-4 py-3 text-sm font-semibold text-red-50 transition hover:bg-red-50/10"
              >
                Back to dashboard
              </a>
            </section>
          )
        }
      </main>
    </div>
  </div>
</Layout>
