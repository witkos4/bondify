---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { consumeGameFlash } from "@/lib/game-flash";
import { callBondifyService, createBondifyServices } from "@/lib/services/bondify";
import type { TeamGameState } from "@/types";

export const prerender = false;

const { teamId = "", gameSlug = "" } = Astro.params;
const decodedTeamId = decodeURIComponent(teamId);
const decodedGameSlug = decodeURIComponent(gameSlug);
const services = createBondifyServices({
  requestHeaders: Astro.request.headers,
  cookies: Astro.cookies,
});

const [shellContextResult, gameStateResult] = await Promise.all([
  callBondifyService(() => services.getShellContext({ preferredTeamId: decodedTeamId })),
  callBondifyService(() =>
    services.getTeamGameState({
      teamId: decodedTeamId,
      gameSlug: decodedGameSlug,
    }),
  ),
]);

const shell = shellContextResult.data;
const gameState: TeamGameState | null = gameStateResult.data;
const gameFlash = consumeGameFlash(Astro.cookies);
const matchingFlash = gameFlash?.teamId === decodedTeamId && gameFlash.gameSlug === decodedGameSlug ? gameFlash : null;
const errorMessage = gameStateResult.error?.message ?? null;
const activeRound = gameState?.activeRound ?? null;
const revealedRound = gameState?.revealedRound ?? null;
const hasSubmitted = activeRound?.hasCurrentMemberSubmitted ?? false;
const submittedCount = activeRound?.submittedResponseCount ?? 0;
const responseTextareaValue = matchingFlash?.type === "response-submit-error" ? matchingFlash.responseText : "";
const pageTitle = gameState ? `${gameState.template.name} | Bondify` : "Team game | Bondify";

function formatResultTime(createdAt: string) {
  return new Intl.DateTimeFormat("en", {
    hour: "2-digit",
    minute: "2-digit",
  }).format(new Date(createdAt));
}
---

<Layout title={pageTitle}>
  <div class="bg-cosmic min-h-screen">
    <div class="mx-auto max-w-5xl px-4 py-4 sm:px-8">
      <Topbar shell={shell} />

      <main class="mt-8 pb-12">
        {
          gameState ? (
            <div class="space-y-6">
              <section class="rounded-[2rem] border border-white/12 bg-white/6 p-6 text-white shadow-2xl shadow-black/20 backdrop-blur-xl sm:p-8">
                <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
                  <div class="max-w-3xl">
                    <p class="text-xs font-semibold tracking-[0.28em] text-cyan-200/70 uppercase">Team game</p>
                    <h1 class="mt-3 text-4xl font-semibold text-white sm:text-5xl">{gameState.template.name}</h1>
                    <p class="mt-4 max-w-2xl text-base leading-7 text-blue-100/75">{gameState.template.prompt}</p>
                  </div>
                  <a
                    href={`/dashboard?team=${encodeURIComponent(gameState.teamId)}`}
                    class="inline-flex rounded-2xl border border-white/15 px-4 py-3 text-sm font-semibold text-blue-100 transition hover:bg-white/10"
                  >
                    Back to dashboard
                  </a>
                </div>

                {matchingFlash && (
                  <div
                    class:list={[
                      "mt-6 rounded-3xl border p-4 text-sm leading-6",
                      matchingFlash.type === "game-started" ||
                      matchingFlash.type === "response-submitted" ||
                      matchingFlash.type === "game-revealed"
                        ? "border-emerald-300/25 bg-emerald-300/10 text-emerald-100"
                        : "border-red-500/30 bg-red-900/40 text-red-200",
                    ]}
                  >
                    {matchingFlash.message}
                  </div>
                )}
              </section>

              <section class="rounded-[2rem] border border-white/12 bg-slate-950/35 p-6 text-white shadow-xl shadow-black/20 backdrop-blur-xl sm:p-8">
                {revealedRound !== null ? (
                  <div class="space-y-6">
                    <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
                      <div class="max-w-2xl">
                        <p class="text-xs font-semibold tracking-[0.25em] text-emerald-100/75 uppercase">
                          Shared results
                        </p>
                        <h2 class="mt-2 text-3xl font-semibold">Your team reveal is ready</h2>
                        <p class="mt-3 text-sm leading-6 text-blue-100/65">
                          Everyone sees the same submitted responses here. Bondify keeps teammate identities out of the
                          reveal so the shared moment stays anonymous.
                        </p>
                      </div>
                      <div class="rounded-3xl border border-white/10 bg-white/6 px-5 py-4 text-right">
                        <p class="text-xs font-semibold tracking-[0.2em] text-blue-100/50 uppercase">Responses</p>
                        <p class="mt-2 text-4xl font-semibold text-white">{revealedRound.responses.length}</p>
                      </div>
                    </div>

                    <div class="grid gap-4 md:grid-cols-2">
                      {revealedRound.responses.map((response, index) => (
                        <article class="rounded-3xl border border-white/10 bg-white/6 p-5">
                          <div class="flex items-start justify-between gap-4">
                            <p class="text-xs font-semibold tracking-[0.2em] text-cyan-100/60 uppercase">
                              Response {index + 1}
                            </p>
                            <time class="text-xs text-blue-100/45" datetime={response.createdAt}>
                              {formatResultTime(response.createdAt)}
                            </time>
                          </div>
                          <p class="mt-4 text-base leading-7 whitespace-pre-wrap text-white">{response.responseText}</p>
                        </article>
                      ))}
                    </div>
                  </div>
                ) : activeRound === null ? (
                  <div class="grid gap-6 lg:grid-cols-[1.3fr_0.7fr] lg:items-center">
                    <div>
                      <p class="text-xs font-semibold tracking-[0.25em] text-amber-100/70 uppercase">Not started</p>
                      <h2 class="mt-2 text-3xl font-semibold">Open this game for your team</h2>
                      <p class="mt-3 text-sm leading-6 text-blue-100/65">
                        Starting creates the active team round in the background. Teammates who open this same game page
                        will join the same prompt.
                      </p>
                    </div>
                    <form method="POST" action="/api/games/start" class="lg:justify-self-end">
                      <input type="hidden" name="teamId" value={gameState.teamId} />
                      <input type="hidden" name="gameSlug" value={gameState.template.slug} />
                      <button
                        type="submit"
                        class="w-full rounded-2xl bg-cyan-400/90 px-5 py-3 text-sm font-semibold text-slate-950 transition hover:bg-cyan-300 lg:w-auto"
                      >
                        Start game
                      </button>
                    </form>
                  </div>
                ) : hasSubmitted ? (
                  <div class="grid gap-6 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
                    <div>
                      <p class="text-xs font-semibold tracking-[0.25em] text-emerald-100/75 uppercase">Submitted</p>
                      <h2 class="mt-2 text-3xl font-semibold">Your response is saved</h2>
                      <p class="mt-3 text-sm leading-6 text-blue-100/65">
                        Responses stay anonymous here. Reveal the round when your team is ready to see the shared
                        results.
                      </p>
                    </div>
                    <div class="rounded-3xl border border-white/10 bg-white/6 p-5">
                      <p class="text-xs font-semibold tracking-[0.2em] text-blue-100/50 uppercase">
                        Anonymous progress
                      </p>
                      <p class="mt-2 text-4xl font-semibold text-white">{submittedCount}</p>
                      <p class="mt-2 text-sm text-blue-100/60">response{submittedCount === 1 ? "" : "s"} submitted</p>
                      <form method="POST" action="/api/games/reveal" class="mt-5">
                        <input type="hidden" name="teamId" value={gameState.teamId} />
                        <input type="hidden" name="gameSlug" value={gameState.template.slug} />
                        <input type="hidden" name="roundId" value={activeRound.round.id} />
                        <button
                          type="submit"
                          class="w-full rounded-2xl bg-emerald-300/90 px-4 py-3 text-sm font-semibold text-slate-950 transition hover:bg-emerald-200"
                        >
                          Reveal results
                        </button>
                      </form>
                    </div>
                  </div>
                ) : (
                  <div class="grid gap-8 lg:grid-cols-[1fr_0.8fr]">
                    <div>
                      <p class="text-xs font-semibold tracking-[0.25em] text-cyan-200/65 uppercase">Your response</p>
                      <h2 class="mt-2 text-3xl font-semibold">Submit anonymously</h2>
                      <p class="mt-3 text-sm leading-6 text-blue-100/65">
                        Each team member can submit once for this active game.
                      </p>

                      <form method="POST" action="/api/games/submit" class="mt-6 space-y-4">
                        <input type="hidden" name="teamId" value={gameState.teamId} />
                        <input type="hidden" name="gameSlug" value={gameState.template.slug} />
                        <input type="hidden" name="roundId" value={activeRound.round.id} />
                        <div>
                          <label class="block text-sm font-medium text-blue-100/75" for="response-text">
                            Response
                          </label>
                          <textarea
                            id="response-text"
                            name="responseText"
                            rows="7"
                            maxlength="500"
                            required
                            placeholder="Write your answer..."
                            class="mt-2 w-full rounded-2xl border border-white/10 bg-slate-950/35 px-4 py-3 text-white transition outline-none focus:border-cyan-300/70"
                          >
                            {responseTextareaValue}
                          </textarea>
                          <p class="mt-2 text-xs leading-5 text-blue-100/50">Required. 500 characters max.</p>
                        </div>
                        <button
                          type="submit"
                          class="w-full rounded-2xl bg-cyan-400/90 px-4 py-3 text-sm font-semibold text-slate-950 transition hover:bg-cyan-300"
                        >
                          Save anonymous response
                        </button>
                      </form>
                    </div>

                    <aside class="rounded-3xl border border-white/10 bg-white/6 p-5">
                      <p class="text-xs font-semibold tracking-[0.2em] text-blue-100/50 uppercase">
                        Anonymous progress
                      </p>
                      <p class="mt-2 text-4xl font-semibold text-white">{submittedCount}</p>
                      <p class="mt-2 text-sm text-blue-100/60">response{submittedCount === 1 ? "" : "s"} submitted</p>
                    </aside>
                  </div>
                )}
              </section>
            </div>
          ) : (
            <section class="rounded-[2rem] border border-red-500/25 bg-red-950/45 p-6 text-red-100 shadow-xl shadow-black/20 backdrop-blur-xl sm:p-8">
              <p class="text-xs font-semibold tracking-[0.25em] text-red-200/70 uppercase">Game unavailable</p>
              <h1 class="mt-2 text-3xl font-semibold">This team game could not be loaded</h1>
              <p class="mt-3 text-sm leading-6 text-red-100/75">
                {errorMessage ?? "Check that you are signed in and belong to this team."}
              </p>
              <a
                href="/dashboard"
                class="mt-6 inline-flex rounded-2xl border border-red-100/25 px-4 py-3 text-sm font-semibold text-red-50 transition hover:bg-red-50/10"
              >
                Back to dashboard
              </a>
            </section>
          )
        }
      </main>
    </div>
  </div>
</Layout>
