---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { isEmojiCheckInTemplateSlug } from "@/lib/emoji-check-in";
import { consumeGameFlash } from "@/lib/game-flash";
import { callBondifyService, createBondifyServices } from "@/lib/services/bondify";
import type { TeamGameState, TwoTruthsEntryRecord, TwoTruthsGuessRecord } from "@/types";

export const prerender = false;

const { teamId = "", gameSlug = "" } = Astro.params;
const decodedTeamId = decodeURIComponent(teamId);
const decodedGameSlug = decodeURIComponent(gameSlug);
const isEmojiCheckInRoute = isEmojiCheckInTemplateSlug(decodedGameSlug);
const services = createBondifyServices({
  requestHeaders: Astro.request.headers,
  cookies: Astro.cookies,
});

const [shellContextResult, gameStateResult] = await Promise.all([
  callBondifyService(() => services.getShellContext({ preferredTeamId: decodedTeamId })),
  isEmojiCheckInRoute
    ? Promise.resolve({
        data: null,
        error: null,
      })
    : callBondifyService(() =>
        services.getTeamGameState({
          teamId: decodedTeamId,
          gameSlug: decodedGameSlug,
        }),
      ),
]);

const shell = shellContextResult.data;
const gameState: TeamGameState | null = gameStateResult.data;
const gameFlash = consumeGameFlash(Astro.cookies);
const matchingFlash = gameFlash?.teamId === decodedTeamId && gameFlash.gameSlug === decodedGameSlug ? gameFlash : null;
const errorMessage = gameStateResult.error?.message ?? null;
const activeRound = gameState?.activeRound ?? null;
const revealedRound = gameState?.revealedRound ?? null;
const twoTruthsRound = gameState?.twoTruthsRound ?? null;
const hasSubmitted = activeRound?.hasCurrentMemberSubmitted ?? false;
const submittedCount = activeRound?.submittedResponseCount ?? 0;
const responseTextareaValue = matchingFlash?.type === "response-submit-error" ? matchingFlash.responseText : "";
const twoTruthsStatementOneValue = matchingFlash?.type === "two-truths-entry-error" ? matchingFlash.statementOne : "";
const twoTruthsStatementTwoValue = matchingFlash?.type === "two-truths-entry-error" ? matchingFlash.statementTwo : "";
const twoTruthsStatementThreeValue =
  matchingFlash?.type === "two-truths-entry-error" ? matchingFlash.statementThree : "";
const twoTruthsLieStatementIndexValue =
  matchingFlash?.type === "two-truths-entry-error" ? matchingFlash.lieStatementIndex : "";
const dashboardEmojiCheckInHref = `/dashboard?team=${encodeURIComponent(decodedTeamId)}#emoji-check-in`;
const pageTitle = isEmojiCheckInRoute
  ? "Emoji Check-In | Bondify"
  : gameState
    ? `${gameState.template.name} | Bondify`
    : "Team game | Bondify";
const twoTruthsPhase = twoTruthsRound?.structuredRound.phase ?? null;
const isTwoTruthsCollecting = twoTruthsPhase === "collecting";
const isTwoTruthsVoting = twoTruthsPhase === "voting";
const twoTruthsVotingEntries = twoTruthsRound?.entries.filter((entry) => entry.includedInVoting) ?? [];
const currentMemberTwoTruthsEntry =
  twoTruthsRound?.entries.find((entry) => entry.id === twoTruthsRound.currentMemberEntryId) ?? null;
const isCurrentMemberTwoTruthsParticipant = currentMemberTwoTruthsEntry !== null;
const currentMembershipId = gameState?.membership.id ?? null;
const currentMemberGuessesByTargetEntryId = new Map(
  (twoTruthsRound?.guesses ?? [])
    .filter((guess) => guess.voter.membershipId === currentMembershipId)
    .map((guess) => [guess.targetEntryId, guess]),
);
const twoTruthsVoteTargets = twoTruthsVotingEntries.filter(
  (entry) => entry.id !== twoTruthsRound?.currentMemberEntryId,
);
const currentMemberOutstandingVoteCount = twoTruthsVoteTargets.filter(
  (entry) => !currentMemberGuessesByTargetEntryId.has(entry.id),
).length;
const twoTruthsScoresByMembershipId = new Map(
  (twoTruthsRound?.revealSummary?.scores ?? []).map((score) => [score.participant.membershipId, score]),
);

function formatResultTime(createdAt: string) {
  return new Intl.DateTimeFormat("en", {
    hour: "2-digit",
    minute: "2-digit",
  }).format(new Date(createdAt));
}

function formatDateTime(createdAt: string | null) {
  if (!createdAt) {
    return "Not available";
  }

  return new Intl.DateTimeFormat("en", {
    month: "short",
    day: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  }).format(new Date(createdAt));
}

function statementLabel(index: number) {
  return `Statement ${index}`;
}

function findGuessesForEntry(entryId: string): TwoTruthsGuessRecord[] {
  return (twoTruthsRound?.guesses ?? []).filter((guess) => guess.targetEntryId === entryId);
}

function guessMatchesEntry(entry: TwoTruthsEntryRecord, guess: TwoTruthsGuessRecord) {
  return entry.lieStatementIndex === guess.guessedLieIndex;
}
---

<Layout title={pageTitle}>
  <div class="bg-cosmic min-h-screen">
    <div class="mx-auto max-w-5xl px-4 py-4 sm:px-8">
      <Topbar shell={shell} />

      <main class="mt-8 pb-12">
        {
          isEmojiCheckInRoute ? (
            <section class="rounded-[2rem] border border-white/12 bg-white/6 p-6 text-white shadow-2xl shadow-black/20 backdrop-blur-xl sm:p-8">
              <p class="text-xs font-semibold tracking-[0.28em] text-amber-100/75 uppercase">Dashboard handoff</p>
              <h1 class="mt-3 text-4xl font-semibold text-white sm:text-5xl">
                Emoji Check-In lives on the dashboard now
              </h1>
              <p class="mt-4 max-w-2xl text-base leading-7 text-blue-100/75">
                Today's team mood ritual is now inline on the selected-team dashboard so everyone shares one equal,
                current view instead of splitting across two completion flows.
              </p>
              <div class="mt-6 flex flex-col gap-3 sm:flex-row">
                <a
                  href={dashboardEmojiCheckInHref}
                  class="inline-flex justify-center rounded-2xl bg-cyan-400/90 px-5 py-3 text-sm font-semibold text-slate-950 transition hover:bg-cyan-300"
                >
                  Go to today's Emoji Check-In
                </a>
                <a
                  href={`/dashboard?team=${encodeURIComponent(decodedTeamId)}`}
                  class="inline-flex justify-center rounded-2xl border border-white/15 px-5 py-3 text-sm font-semibold text-blue-100 transition hover:bg-white/10"
                >
                  Back to dashboard
                </a>
              </div>
            </section>
          ) : gameState ? (
            <div class="space-y-6">
              <section class="rounded-[2rem] border border-white/12 bg-white/6 p-6 text-white shadow-2xl shadow-black/20 backdrop-blur-xl sm:p-8">
                <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
                  <div class="max-w-3xl">
                    <p class="text-xs font-semibold tracking-[0.28em] text-cyan-200/70 uppercase">Team game</p>
                    <h1 class="mt-3 text-4xl font-semibold text-white sm:text-5xl">{gameState.template.name}</h1>
                    <p class="mt-4 max-w-2xl text-base leading-7 text-blue-100/75">{gameState.template.prompt}</p>
                  </div>
                  <a
                    href={`/dashboard?team=${encodeURIComponent(gameState.teamId)}`}
                    class="inline-flex rounded-2xl border border-white/15 px-4 py-3 text-sm font-semibold text-blue-100 transition hover:bg-white/10"
                  >
                    Back to dashboard
                  </a>
                </div>

                {matchingFlash && (
                  <div
                    class:list={[
                      "mt-6 rounded-3xl border p-4 text-sm leading-6",
                      matchingFlash.type === "game-started" ||
                      matchingFlash.type === "response-submitted" ||
                      matchingFlash.type === "two-truths-entry-submitted" ||
                      matchingFlash.type === "two-truths-collection-closed" ||
                      matchingFlash.type === "two-truths-vote-submitted" ||
                      matchingFlash.type === "two-truths-voting-closed" ||
                      matchingFlash.type === "game-revealed"
                        ? "border-emerald-300/25 bg-emerald-300/10 text-emerald-100"
                        : "border-red-500/30 bg-red-900/40 text-red-200",
                    ]}
                  >
                    {matchingFlash.message}
                  </div>
                )}
              </section>

              <section class="rounded-[2rem] border border-white/12 bg-slate-950/35 p-6 text-white shadow-xl shadow-black/20 backdrop-blur-xl sm:p-8">
                {twoTruthsRound !== null ? (
                  <div class="space-y-6">
                    <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
                      <div class="max-w-2xl">
                        <p class="text-xs font-semibold tracking-[0.25em] text-amber-100/75 uppercase">
                          Structured round
                        </p>
                        <h2 class="mt-2 text-3xl font-semibold">
                          {isTwoTruthsCollecting
                            ? "Collection is open"
                            : isTwoTruthsVoting
                              ? "Voting is active"
                              : "Reveal is ready"}
                        </h2>
                        <p class="mt-3 text-sm leading-6 text-blue-100/65">
                          {isTwoTruthsCollecting
                            ? "Each teammate can submit one authored set. Once collection closes, only submitted sets move into the round and edits stay locked."
                            : isTwoTruthsVoting
                              ? "Author names are visible, but guesses stay private until reveal. Every submitted participant votes once on every other set."
                              : "The round is closed. Scores reward both correct guesses and the teammates each author managed to fool."}
                        </p>
                      </div>
                      <div class="rounded-3xl border border-white/10 bg-white/6 px-5 py-4 text-right">
                        <p class="text-xs font-semibold tracking-[0.2em] text-blue-100/50 uppercase">
                          {isTwoTruthsCollecting ? "Submitted sets" : "Votes recorded"}
                        </p>
                        <p class="mt-2 text-4xl font-semibold text-white">
                          {isTwoTruthsCollecting
                            ? twoTruthsRound.entries.length
                            : `${twoTruthsRound.guessProgress.submittedGuessCount}/${twoTruthsRound.guessProgress.requiredTotalGuessCount}`}
                        </p>
                        <p class="mt-2 text-sm text-blue-100/60">
                          {isTwoTruthsCollecting
                            ? `${twoTruthsRound.entries.length === 1 ? "1 set is" : "Sets are"} ready for this round`
                            : isTwoTruthsVoting
                              ? "Reveal triggers automatically when the last required guess lands"
                              : `${twoTruthsRound.revealSummary?.totalGuessesRecorded ?? 0} total guess${twoTruthsRound.revealSummary?.totalGuessesRecorded === 1 ? "" : "es"} counted`}
                        </p>
                      </div>
                    </div>

                    {isTwoTruthsCollecting ? (
                      <div class="grid gap-6 lg:grid-cols-[1fr_0.8fr]">
                        <div class="space-y-5">
                          {twoTruthsRound.hasCurrentMemberSubmitted ? (
                            <div class="rounded-3xl border border-emerald-300/20 bg-emerald-300/10 p-5">
                              <p class="text-xs font-semibold tracking-[0.2em] text-emerald-100/70 uppercase">
                                Locked in
                              </p>
                              <h3 class="mt-2 text-2xl font-semibold">Your set is saved</h3>
                              <p class="mt-3 text-sm leading-6 text-emerald-50/80">
                                You are part of this round. Your statements are locked, and collection can close as soon
                                as the team has enough submitted sets.
                              </p>
                            </div>
                          ) : (
                            <form method="POST" action="/api/games/two-truths-entry" class="space-y-5">
                              <input type="hidden" name="teamId" value={gameState.teamId} />
                              <input type="hidden" name="gameSlug" value={gameState.template.slug} />
                              <input type="hidden" name="roundId" value={twoTruthsRound.round.id} />
                              <div class="grid gap-4">
                                <div>
                                  <label class="block text-sm font-medium text-blue-100/75" for="statement-one">
                                    Statement 1
                                  </label>
                                  <textarea
                                    id="statement-one"
                                    name="statementOne"
                                    rows="3"
                                    maxlength="200"
                                    required
                                    placeholder="Write a short statement..."
                                    class="mt-2 w-full rounded-2xl border border-white/10 bg-slate-950/35 px-4 py-3 text-white transition outline-none focus:border-cyan-300/70"
                                    set:text={twoTruthsStatementOneValue}
                                  />
                                </div>
                                <div>
                                  <label class="block text-sm font-medium text-blue-100/75" for="statement-two">
                                    Statement 2
                                  </label>
                                  <textarea
                                    id="statement-two"
                                    name="statementTwo"
                                    rows="3"
                                    maxlength="200"
                                    required
                                    placeholder="Write a short statement..."
                                    class="mt-2 w-full rounded-2xl border border-white/10 bg-slate-950/35 px-4 py-3 text-white transition outline-none focus:border-cyan-300/70"
                                    set:text={twoTruthsStatementTwoValue}
                                  />
                                </div>
                                <div>
                                  <label class="block text-sm font-medium text-blue-100/75" for="statement-three">
                                    Statement 3
                                  </label>
                                  <textarea
                                    id="statement-three"
                                    name="statementThree"
                                    rows="3"
                                    maxlength="200"
                                    required
                                    placeholder="Write a short statement..."
                                    class="mt-2 w-full rounded-2xl border border-white/10 bg-slate-950/35 px-4 py-3 text-white transition outline-none focus:border-cyan-300/70"
                                    set:text={twoTruthsStatementThreeValue}
                                  />
                                </div>
                              </div>

                              <fieldset>
                                <legend class="text-sm font-medium text-blue-100/75">
                                  Which statement is the lie?
                                </legend>
                                <div class="mt-3 grid gap-3 sm:grid-cols-3">
                                  {[1, 2, 3].map((index) => (
                                    <label class="flex items-center gap-3 rounded-2xl border border-white/10 bg-white/6 px-4 py-3 text-sm">
                                      <input
                                        type="radio"
                                        name="lieStatementIndex"
                                        value={index}
                                        checked={twoTruthsLieStatementIndexValue === String(index)}
                                        class="h-4 w-4"
                                      />
                                      {statementLabel(index)}
                                    </label>
                                  ))}
                                </div>
                              </fieldset>

                              <button
                                type="submit"
                                class="w-full rounded-2xl bg-cyan-400/90 px-4 py-3 text-sm font-semibold text-slate-950 transition hover:bg-cyan-300"
                              >
                                Save structured set
                              </button>
                            </form>
                          )}

                          {currentMemberTwoTruthsEntry && (
                            <article class="rounded-3xl border border-white/10 bg-white/6 p-5">
                              <div class="flex items-start justify-between gap-4">
                                <div>
                                  <p class="text-xs font-semibold tracking-[0.18em] text-cyan-100/60 uppercase">
                                    Your locked set
                                  </p>
                                  <h3 class="mt-2 text-xl font-semibold text-white">
                                    {currentMemberTwoTruthsEntry.author.email}
                                  </h3>
                                </div>
                                <p class="text-xs text-blue-100/45">
                                  Saved {formatResultTime(currentMemberTwoTruthsEntry.createdAt)}
                                </p>
                              </div>
                              <ol class="mt-4 space-y-3">
                                {currentMemberTwoTruthsEntry.statements.map((statement, index) => (
                                  <li class="rounded-2xl border border-white/10 bg-slate-950/25 px-4 py-3 text-sm leading-6 text-white">
                                    <span class="mb-1 block text-xs font-semibold tracking-[0.18em] text-blue-100/50 uppercase">
                                      {statementLabel(index + 1)}
                                    </span>
                                    {statement}
                                  </li>
                                ))}
                              </ol>
                            </article>
                          )}
                        </div>

                        <aside class="space-y-4">
                          <div class="rounded-3xl border border-white/10 bg-white/6 p-5">
                            <p class="text-xs font-semibold tracking-[0.2em] text-blue-100/50 uppercase">
                              Round progress
                            </p>
                            <p class="mt-2 text-4xl font-semibold text-white">{twoTruthsRound.entries.length}</p>
                            <p class="mt-2 text-sm leading-6 text-blue-100/60">
                              {twoTruthsRound.entries.length >= 2
                                ? "Collection can close whenever the team is ready."
                                : "You need at least two submitted sets before voting can begin."}
                            </p>

                            {twoTruthsRound.entries.length >= 2 ? (
                              <form method="POST" action="/api/games/two-truths-close-collection" class="mt-5">
                                <input type="hidden" name="teamId" value={gameState.teamId} />
                                <input type="hidden" name="gameSlug" value={gameState.template.slug} />
                                <input type="hidden" name="roundId" value={twoTruthsRound.round.id} />
                                <button
                                  type="submit"
                                  class="w-full rounded-2xl bg-emerald-300/90 px-4 py-3 text-sm font-semibold text-slate-950 transition hover:bg-emerald-200"
                                >
                                  Close collection and open voting
                                </button>
                              </form>
                            ) : null}
                          </div>

                          <div class="rounded-3xl border border-white/10 bg-white/6 p-5">
                            <p class="text-xs font-semibold tracking-[0.2em] text-blue-100/50 uppercase">
                              Submitted authors
                            </p>
                            {twoTruthsRound.entries.length > 0 ? (
                              <ul class="mt-4 space-y-3">
                                {twoTruthsRound.entries.map((entry) => (
                                  <li class="rounded-2xl border border-white/10 bg-slate-950/25 px-4 py-3 text-sm text-white">
                                    {entry.author.email}
                                  </li>
                                ))}
                              </ul>
                            ) : (
                              <p class="mt-4 text-sm leading-6 text-blue-100/60">
                                Nobody has submitted yet. The first set opens the round history window automatically.
                              </p>
                            )}
                          </div>
                        </aside>
                      </div>
                    ) : isTwoTruthsVoting ? (
                      <div class="space-y-6">
                        <div class="grid gap-4 lg:grid-cols-[1fr_0.8fr]">
                          <div class="rounded-3xl border border-white/10 bg-white/6 p-5">
                            <p class="text-xs font-semibold tracking-[0.18em] text-cyan-100/60 uppercase">
                              Your voting status
                            </p>
                            {isCurrentMemberTwoTruthsParticipant ? (
                              <>
                                <h3 class="mt-2 text-2xl font-semibold text-white">
                                  {currentMemberOutstandingVoteCount === 0
                                    ? "You have voted on every teammate set"
                                    : `${currentMemberOutstandingVoteCount} guess${currentMemberOutstandingVoteCount === 1 ? "" : "es"} left`}
                                </h3>
                                <p class="mt-3 text-sm leading-6 text-blue-100/65">
                                  Your own set stays locked out of voting. Results remain hidden until the round closes.
                                </p>
                              </>
                            ) : (
                              <>
                                <h3 class="mt-2 text-2xl font-semibold text-white">You are watching this round</h3>
                                <p class="mt-3 text-sm leading-6 text-blue-100/65">
                                  Only teammates who submitted before collection closed vote in this round. You can
                                  still follow reveal progress here.
                                </p>
                              </>
                            )}
                          </div>

                          <div class="rounded-3xl border border-white/10 bg-white/6 p-5">
                            <p class="text-xs font-semibold tracking-[0.18em] text-blue-100/50 uppercase">
                              Team progress
                            </p>
                            <h3 class="mt-2 text-2xl font-semibold text-white">
                              {twoTruthsRound.guessProgress.submittedGuessCount} of{" "}
                              {twoTruthsRound.guessProgress.requiredTotalGuessCount}
                            </h3>
                            <p class="mt-3 text-sm leading-6 text-blue-100/65">
                              {twoTruthsRound.guessProgress.allRequiredGuessesSubmitted
                                ? "Every required guess is in. The next refresh will show reveal."
                                : "The round reveals automatically when the last required guess is saved."}
                            </p>
                          </div>
                        </div>

                        {currentMemberTwoTruthsEntry && (
                          <article class="rounded-3xl border border-white/10 bg-white/6 p-5">
                            <p class="text-xs font-semibold tracking-[0.18em] text-emerald-100/70 uppercase">
                              Your locked set
                            </p>
                            <h3 class="mt-2 text-xl font-semibold text-white">
                              {currentMemberTwoTruthsEntry.author.email}
                            </h3>
                            <ol class="mt-4 grid gap-3 md:grid-cols-3">
                              {currentMemberTwoTruthsEntry.statements.map((statement, index) => (
                                <li class="rounded-2xl border border-white/10 bg-slate-950/25 px-4 py-3 text-sm leading-6 text-white">
                                  <span class="mb-1 block text-xs font-semibold tracking-[0.18em] text-blue-100/50 uppercase">
                                    {statementLabel(index + 1)}
                                  </span>
                                  {statement}
                                </li>
                              ))}
                            </ol>
                          </article>
                        )}

                        <div class="grid gap-4">
                          {twoTruthsVoteTargets.map((entry) => {
                            const existingGuess = currentMemberGuessesByTargetEntryId.get(entry.id);

                            return (
                              <article class="rounded-3xl border border-white/10 bg-white/6 p-5">
                                <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                                  <div>
                                    <p class="text-xs font-semibold tracking-[0.18em] text-cyan-100/60 uppercase">
                                      Guess this set
                                    </p>
                                    <h3 class="mt-2 text-xl font-semibold text-white">{entry.author.email}</h3>
                                  </div>
                                  {existingGuess ? (
                                    <div class="rounded-2xl border border-emerald-300/20 bg-emerald-300/10 px-4 py-2 text-sm text-emerald-100">
                                      Locked guess: {statementLabel(existingGuess.guessedLieIndex)}
                                    </div>
                                  ) : null}
                                </div>

                                <ol class="mt-4 grid gap-3 md:grid-cols-3">
                                  {entry.statements.map((statement, index) => (
                                    <li class="rounded-2xl border border-white/10 bg-slate-950/25 px-4 py-3 text-sm leading-6 text-white">
                                      <span class="mb-1 block text-xs font-semibold tracking-[0.18em] text-blue-100/50 uppercase">
                                        {statementLabel(index + 1)}
                                      </span>
                                      {statement}
                                    </li>
                                  ))}
                                </ol>

                                {isCurrentMemberTwoTruthsParticipant ? (
                                  existingGuess ? null : (
                                    <form method="POST" action="/api/games/two-truths-vote" class="mt-5 space-y-4">
                                      <input type="hidden" name="teamId" value={gameState.teamId} />
                                      <input type="hidden" name="gameSlug" value={gameState.template.slug} />
                                      <input type="hidden" name="roundId" value={twoTruthsRound.round.id} />
                                      <input type="hidden" name="targetEntryId" value={entry.id} />
                                      <fieldset>
                                        <legend class="text-sm font-medium text-blue-100/75">
                                          Which statement do you think is the lie?
                                        </legend>
                                        <div class="mt-3 grid gap-3 sm:grid-cols-3">
                                          {[1, 2, 3].map((index) => (
                                            <label class="flex items-center gap-3 rounded-2xl border border-white/10 bg-white/6 px-4 py-3 text-sm">
                                              <input
                                                type="radio"
                                                name="guessedLieIndex"
                                                value={index}
                                                class="h-4 w-4"
                                              />
                                              {statementLabel(index)}
                                            </label>
                                          ))}
                                        </div>
                                      </fieldset>
                                      <button
                                        type="submit"
                                        class="w-full rounded-2xl bg-cyan-400/90 px-4 py-3 text-sm font-semibold text-slate-950 transition hover:bg-cyan-300"
                                      >
                                        Save guess
                                      </button>
                                    </form>
                                  )
                                ) : null}
                              </article>
                            );
                          })}
                        </div>

                        {!twoTruthsRound.guessProgress.allRequiredGuessesSubmitted ? (
                          <div class="rounded-3xl border border-amber-300/20 bg-amber-300/10 p-5">
                            <p class="text-xs font-semibold tracking-[0.18em] text-amber-100/75 uppercase">
                              Manual fallback
                            </p>
                            <h3 class="mt-2 text-2xl font-semibold text-white">Close voting early if needed</h3>
                            <p class="mt-3 text-sm leading-6 text-amber-50/85">
                              Missing guesses are ignored during scoring. Use this only if the team wants to finish the
                              round without waiting for the last few votes.
                            </p>
                            <form method="POST" action="/api/games/two-truths-close-voting" class="mt-5">
                              <input type="hidden" name="teamId" value={gameState.teamId} />
                              <input type="hidden" name="gameSlug" value={gameState.template.slug} />
                              <input type="hidden" name="roundId" value={twoTruthsRound.round.id} />
                              <button
                                type="submit"
                                class="w-full rounded-2xl bg-amber-200/90 px-4 py-3 text-sm font-semibold text-slate-950 transition hover:bg-amber-100"
                              >
                                Close voting and reveal recorded guesses
                              </button>
                            </form>
                          </div>
                        ) : null}
                      </div>
                    ) : (
                      <div class="space-y-6">
                        {twoTruthsRound.revealSummary && (
                          <section class="rounded-3xl border border-white/10 bg-white/6 p-5">
                            <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
                              <div>
                                <p class="text-xs font-semibold tracking-[0.18em] text-emerald-100/70 uppercase">
                                  Round scoring
                                </p>
                                <h3 class="mt-2 text-2xl font-semibold text-white">
                                  Correct guesses plus teammates fooled
                                </h3>
                              </div>
                              <p class="text-sm text-blue-100/60">
                                {twoTruthsRound.revealSummary.totalGuessesRecorded} recorded guess
                                {twoTruthsRound.revealSummary.totalGuessesRecorded === 1 ? "" : "es"}
                              </p>
                            </div>

                            <div class="mt-5 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                              {twoTruthsRound.revealSummary.scores.map((score) => (
                                <article class="rounded-3xl border border-white/10 bg-slate-950/25 p-4">
                                  <p class="text-xs font-semibold tracking-[0.18em] text-cyan-100/60 uppercase">
                                    {score.participant.email}
                                  </p>
                                  <p class="mt-2 text-4xl font-semibold text-white">{score.totalScore}</p>
                                  <p class="mt-3 text-sm text-blue-100/65">
                                    {score.correctGuessCount} correct guess{score.correctGuessCount === 1 ? "" : "es"}{" "}
                                    and {score.fooledTeammateCount} teammate{score.fooledTeammateCount === 1 ? "" : "s"}{" "}
                                    fooled
                                  </p>
                                </article>
                              ))}
                            </div>
                          </section>
                        )}

                        <div class="grid gap-4">
                          {twoTruthsVotingEntries.map((entry) => {
                            const entryGuesses = findGuessesForEntry(entry.id);
                            const score = twoTruthsScoresByMembershipId.get(entry.author.membershipId);

                            return (
                              <article class="rounded-3xl border border-white/10 bg-white/6 p-5">
                                <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                                  <div>
                                    <p class="text-xs font-semibold tracking-[0.18em] text-cyan-100/60 uppercase">
                                      Final reveal
                                    </p>
                                    <h3 class="mt-2 text-xl font-semibold text-white">{entry.author.email}</h3>
                                    <p class="mt-2 text-sm text-blue-100/55">
                                      Voting closed {formatDateTime(twoTruthsRound.structuredRound.votingClosedAt)}
                                    </p>
                                  </div>
                                  {score ? (
                                    <div class="rounded-3xl border border-emerald-300/20 bg-emerald-300/10 px-4 py-3 text-right">
                                      <p class="text-xs font-semibold tracking-[0.18em] text-emerald-100/70 uppercase">
                                        Total score
                                      </p>
                                      <p class="mt-1 text-3xl font-semibold text-white">{score.totalScore}</p>
                                    </div>
                                  ) : null}
                                </div>

                                <ol class="mt-4 grid gap-3 md:grid-cols-3">
                                  {entry.statements.map((statement, index) => {
                                    const isLie = entry.lieStatementIndex === index + 1;

                                    return (
                                      <li
                                        class:list={[
                                          "rounded-2xl border px-4 py-3 text-sm leading-6",
                                          isLie
                                            ? "border-amber-300/30 bg-amber-300/10 text-amber-50"
                                            : "border-white/10 bg-slate-950/25 text-white",
                                        ]}
                                      >
                                        <span class="mb-1 block text-xs font-semibold tracking-[0.18em] uppercase">
                                          {statementLabel(index + 1)}
                                        </span>
                                        <p>{statement}</p>
                                        {isLie ? (
                                          <p class="mt-3 text-xs font-semibold tracking-[0.16em] text-amber-100 uppercase">
                                            This was the lie
                                          </p>
                                        ) : null}
                                      </li>
                                    );
                                  })}
                                </ol>

                                <div class="mt-5 rounded-3xl border border-white/10 bg-slate-950/25 p-4">
                                  <p class="text-xs font-semibold tracking-[0.18em] text-blue-100/50 uppercase">
                                    Teammate guesses
                                  </p>
                                  {entryGuesses.length > 0 ? (
                                    <ul class="mt-4 space-y-3">
                                      {entryGuesses.map((guess) => (
                                        <li class="flex flex-col gap-2 rounded-2xl border border-white/10 bg-white/6 px-4 py-3 text-sm sm:flex-row sm:items-center sm:justify-between">
                                          <div>
                                            <p class="font-medium text-white">{guess.voter.email}</p>
                                            <p class="text-blue-100/65">
                                              Guessed {statementLabel(guess.guessedLieIndex)}
                                            </p>
                                          </div>
                                          <span
                                            class:list={[
                                              "rounded-full px-3 py-1 text-xs font-semibold uppercase",
                                              guessMatchesEntry(entry, guess)
                                                ? "bg-emerald-300/15 text-emerald-100"
                                                : "bg-amber-300/15 text-amber-100",
                                            ]}
                                          >
                                            {guessMatchesEntry(entry, guess) ? "Correct guess" : "Author fooled them"}
                                          </span>
                                        </li>
                                      ))}
                                    </ul>
                                  ) : (
                                    <p class="mt-4 text-sm leading-6 text-blue-100/60">
                                      No teammate guesses were recorded for this set before reveal.
                                    </p>
                                  )}
                                </div>
                              </article>
                            );
                          })}
                        </div>
                      </div>
                    )}
                  </div>
                ) : revealedRound !== null ? (
                  <div class="space-y-6">
                    <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
                      <div class="max-w-2xl">
                        <p class="text-xs font-semibold tracking-[0.25em] text-emerald-100/75 uppercase">
                          Shared results
                        </p>
                        <h2 class="mt-2 text-3xl font-semibold">Your team reveal is ready</h2>
                        <p class="mt-3 text-sm leading-6 text-blue-100/65">
                          Everyone sees the same submitted responses here. Bondify keeps teammate identities out of the
                          reveal so the shared moment stays anonymous.
                        </p>
                      </div>
                      <div class="rounded-3xl border border-white/10 bg-white/6 px-5 py-4 text-right">
                        <p class="text-xs font-semibold tracking-[0.2em] text-blue-100/50 uppercase">Responses</p>
                        <p class="mt-2 text-4xl font-semibold text-white">{revealedRound.responses.length}</p>
                      </div>
                    </div>

                    <div class="grid gap-4 md:grid-cols-2">
                      {revealedRound.responses.map((response, index) => (
                        <article class="rounded-3xl border border-white/10 bg-white/6 p-5">
                          <div class="flex items-start justify-between gap-4">
                            <p class="text-xs font-semibold tracking-[0.2em] text-cyan-100/60 uppercase">
                              Response {index + 1}
                            </p>
                            <time class="text-xs text-blue-100/45" datetime={response.createdAt}>
                              {formatResultTime(response.createdAt)}
                            </time>
                          </div>
                          <p class="mt-4 text-base leading-7 whitespace-pre-wrap text-white">{response.responseText}</p>
                        </article>
                      ))}
                    </div>
                  </div>
                ) : activeRound === null ? (
                  <div class="grid gap-6 lg:grid-cols-[1.3fr_0.7fr] lg:items-center">
                    <div>
                      <p class="text-xs font-semibold tracking-[0.25em] text-amber-100/70 uppercase">Not started</p>
                      <h2 class="mt-2 text-3xl font-semibold">Open this game for your team</h2>
                      <p class="mt-3 text-sm leading-6 text-blue-100/65">
                        Starting creates the active team round in the background. Teammates who open this same game page
                        will join the same prompt.
                      </p>
                    </div>
                    <form method="POST" action="/api/games/start" class="lg:justify-self-end">
                      <input type="hidden" name="teamId" value={gameState.teamId} />
                      <input type="hidden" name="gameSlug" value={gameState.template.slug} />
                      <button
                        type="submit"
                        class="w-full rounded-2xl bg-cyan-400/90 px-5 py-3 text-sm font-semibold text-slate-950 transition hover:bg-cyan-300 lg:w-auto"
                      >
                        Start game
                      </button>
                    </form>
                  </div>
                ) : hasSubmitted ? (
                  <div class="grid gap-6 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
                    <div>
                      <p class="text-xs font-semibold tracking-[0.25em] text-emerald-100/75 uppercase">Submitted</p>
                      <h2 class="mt-2 text-3xl font-semibold">Your response is saved</h2>
                      <p class="mt-3 text-sm leading-6 text-blue-100/65">
                        Responses stay anonymous here. Reveal the round when your team is ready to see the shared
                        results.
                      </p>
                    </div>
                    <div class="rounded-3xl border border-white/10 bg-white/6 p-5">
                      <p class="text-xs font-semibold tracking-[0.2em] text-blue-100/50 uppercase">
                        Anonymous progress
                      </p>
                      <p class="mt-2 text-4xl font-semibold text-white">{submittedCount}</p>
                      <p class="mt-2 text-sm text-blue-100/60">response{submittedCount === 1 ? "" : "s"} submitted</p>
                      <form method="POST" action="/api/games/reveal" class="mt-5">
                        <input type="hidden" name="teamId" value={gameState.teamId} />
                        <input type="hidden" name="gameSlug" value={gameState.template.slug} />
                        <input type="hidden" name="roundId" value={activeRound.round.id} />
                        <button
                          type="submit"
                          class="w-full rounded-2xl bg-emerald-300/90 px-4 py-3 text-sm font-semibold text-slate-950 transition hover:bg-emerald-200"
                        >
                          Reveal results
                        </button>
                      </form>
                    </div>
                  </div>
                ) : (
                  <div class="grid gap-8 lg:grid-cols-[1fr_0.8fr]">
                    <div>
                      <p class="text-xs font-semibold tracking-[0.25em] text-cyan-200/65 uppercase">Your response</p>
                      <h2 class="mt-2 text-3xl font-semibold">Submit anonymously</h2>
                      <p class="mt-3 text-sm leading-6 text-blue-100/65">
                        Each team member can submit once for this active game.
                      </p>

                      <form method="POST" action="/api/games/submit" class="mt-6 space-y-4">
                        <input type="hidden" name="teamId" value={gameState.teamId} />
                        <input type="hidden" name="gameSlug" value={gameState.template.slug} />
                        <input type="hidden" name="roundId" value={activeRound.round.id} />
                        <div>
                          <label class="block text-sm font-medium text-blue-100/75" for="response-text">
                            Response
                          </label>
                          <textarea
                            id="response-text"
                            name="responseText"
                            rows="7"
                            maxlength="500"
                            required
                            placeholder="Write your answer..."
                            class="mt-2 w-full rounded-2xl border border-white/10 bg-slate-950/35 px-4 py-3 text-white transition outline-none focus:border-cyan-300/70"
                            set:text={responseTextareaValue}
                          />
                          <p class="mt-2 text-xs leading-5 text-blue-100/50">Required. 500 characters max.</p>
                        </div>
                        <button
                          type="submit"
                          class="w-full rounded-2xl bg-cyan-400/90 px-4 py-3 text-sm font-semibold text-slate-950 transition hover:bg-cyan-300"
                        >
                          Save anonymous response
                        </button>
                      </form>
                    </div>

                    <aside class="rounded-3xl border border-white/10 bg-white/6 p-5">
                      <p class="text-xs font-semibold tracking-[0.2em] text-blue-100/50 uppercase">
                        Anonymous progress
                      </p>
                      <p class="mt-2 text-4xl font-semibold text-white">{submittedCount}</p>
                      <p class="mt-2 text-sm text-blue-100/60">response{submittedCount === 1 ? "" : "s"} submitted</p>
                    </aside>
                  </div>
                )}
              </section>
            </div>
          ) : (
            <section class="rounded-[2rem] border border-red-500/25 bg-red-950/45 p-6 text-red-100 shadow-xl shadow-black/20 backdrop-blur-xl sm:p-8">
              <p class="text-xs font-semibold tracking-[0.25em] text-red-200/70 uppercase">Game unavailable</p>
              <h1 class="mt-2 text-3xl font-semibold">This team game could not be loaded</h1>
              <p class="mt-3 text-sm leading-6 text-red-100/75">
                {errorMessage ?? "Check that you are signed in and belong to this team."}
              </p>
              <a
                href="/dashboard"
                class="mt-6 inline-flex rounded-2xl border border-red-100/25 px-4 py-3 text-sm font-semibold text-red-50 transition hover:bg-red-50/10"
              >
                Back to dashboard
              </a>
            </section>
          )
        }
      </main>
    </div>
  </div>
</Layout>
